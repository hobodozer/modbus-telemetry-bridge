<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net8.0, not net8.0-windows: the engine, protocol and tag bus have no Windows
         SDK dependency. The Windows-only parts are P/Invoke (vJoy, SendInput, PDH, timer
         resolution), which compiles anywhere and is guarded at runtime. Only the WPF app is
         genuinely Windows-bound, so pinning this too made the whole solution unbuildable off
         Windows for no reason. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ModbusBridge.Core</RootNamespace>
    <AssemblyName>ModbusBridge.Core</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiled into both the bridge and the net48 SimHub plugin, so the two ends of the
         telemetry wire format cannot drift apart. -->
    <Compile Include="..\..\shared\TelemetryProtocol.cs" Link="Telemetry\TelemetryProtocol.cs" />
  </ItemGroup>

</Project>
