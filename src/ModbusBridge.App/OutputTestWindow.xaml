<Window x:Class="ModbusBridge.App.OutputTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test outputs" Height="600" Width="760"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgInput}" CornerRadius="3" Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="This drives real outputs." FontWeight="SemiBold" FontSize="15" />
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Each control forces its tag, which the write group sends to the PLC. Forced tags ignore whatever normally drives them until released. Everything is released automatically when this window closes." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="All off" Click="OnAllOff" />
            <Button Content="All on" Click="OnAllOn" />
            <Button x:Name="SweepButton" Content="Sweep" Click="OnSweep"
                    ToolTip="Turn each output on in turn, so you can see or hear which is which." />
            <Label Content="Dwell (ms)" Margin="10,0,0,0" />
            <TextBox x:Name="DwellBox" Width="60" Text="600" />
            <Button Content="Release all" Click="OnReleaseAll" Margin="18,0,0,0"
                    ToolTip="Hand every output back to whatever normally drives it." />
            <TextBlock x:Name="StateText" VerticalAlignment="Center" Margin="18,0,0,0"
                       Style="{StaticResource Muted}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OutputList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="54" Height="22" CornerRadius="3"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{Binding StateBrush}">
                                    <TextBlock Text="{Binding StateText}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#101010" />
                                </Border>

                                <TextBlock Grid.Column="1" Text="{Binding Tag}" FontFamily="Consolas"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="2" Text="{Binding Where}" Style="{StaticResource Muted}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button Content="On" Width="46" Tag="{Binding}" Click="OnRowOn" />
                                    <Button Content="Off" Width="46" Tag="{Binding}" Click="OnRowOff" />
                                    <Button Content="Pulse" Width="56" Tag="{Binding}" Click="OnRowPulse" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="OnClose" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
