<Window x:Class="ModbusBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:data="clr-namespace:ModbusBridge.Core.Data;assembly=ModbusBridge.Core"
        xmlns:cfg="clr-namespace:ModbusBridge.Core.Config;assembly=ModbusBridge.Core"
        xmlns:vjoy="clr-namespace:ModbusBridge.Core.Outputs.VJoy;assembly=ModbusBridge.Core"
        Title="{Binding WindowTitle}" Height="820" Width="1360" MinWidth="960" MinHeight="600"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ObjectDataProvider x:Key="DataTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="data:PointDataType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AreaValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="data:ModbusArea" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AccessValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="data:AccessMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="WriteModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="data:WriteMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="StaleValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="data:StaleBehavior" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="VJoyAxisValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vjoy:VJoyAxis" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="VJoyButtonModeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="cfg:VJoyButtonMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="WordOrderValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="data:WordOrder" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ByteOrderValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="data:ByteOrder" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- One metric in a status card: big number over a small caption. -->
        <DataTemplate x:Key="MetricTemplate">
            <StackPanel Margin="0,0,18,0">
                <TextBlock Text="{Binding Value}" Style="{StaticResource Metric}" />
                <TextBlock Text="{Binding Caption}" Style="{StaticResource MetricLabel}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>

        <!-- ============================ Toolbar ============================ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}" Padding="10,7"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Start" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="Stop" Command="{Binding StopCommand}" />
                    <Button Content="Restart" Command="{Binding RestartCommand}" />
                    <Separator Margin="6,0" Width="1" />
                    <Button Content="Apply and restart" Command="{Binding ApplyCommand}"
                            ToolTip="Validate the configuration, save it, and restart the engine on it." />
                    <Button Content="Save" Command="{Binding SaveCommand}" />
                    <Button Content="Reload from disk" Command="{Binding ReloadCommand}" />
                    <Button Content="Config folder" Command="{Binding OpenConfigFolderCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Bad}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding EngineStateText}" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ Status bar ============================ -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock Text="{Binding Status}" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource Muted}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="RootTabs" Background="{StaticResource Bg}">

            <!-- ============================ Dashboard ============================ -->
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="PLC connections" Style="{StaticResource Heading}" />

                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="820"
                                   HorizontalAlignment="Left"
                                   Text="Add a PLC on the Devices tab, or turn on the virtual PLC under Simulation to exercise the whole path without hardware.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeviceStatuses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding DeviceStatuses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="640">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Endpoint}" Style="{StaticResource Muted}"
                                                           Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right"
                                                           Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                            </DockPanel>

                                            <!-- The latency readout -->
                                            <Border Background="{StaticResource BgInput}" CornerRadius="3"
                                                    Padding="10,8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Margin="0,0,22,0">
                                                            <TextBlock Text="{Binding CycleTime}"
                                                                       Style="{StaticResource MetricLarge}"
                                                                       Foreground="{Binding CycleBrush}" />
                                                            <TextBlock Text="poll cycle" Style="{StaticResource MetricLabel}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,22,0">
                                                            <TextBlock Text="{Binding LastLatency}"
                                                                       Style="{StaticResource MetricLarge}" />
                                                            <TextBlock Text="round trip" Style="{StaticResource MetricLabel}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,22,0">
                                                            <TextBlock Text="{Binding PollRate}" Style="{StaticResource MetricLarge}" />
                                                            <TextBlock Text="poll rate" Style="{StaticResource MetricLabel}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <StackPanel Margin="0,0,18,0">
                                                            <TextBlock Text="{Binding AverageLatency}" Style="{StaticResource Metric}" />
                                                            <TextBlock Text="avg" Style="{StaticResource MetricLabel}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,18,0">
                                                            <TextBlock Text="{Binding MinLatency}" Style="{StaticResource Metric}" />
                                                            <TextBlock Text="min" Style="{StaticResource MetricLabel}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,18,0">
                                                            <TextBlock Text="{Binding MaxLatency}" Style="{StaticResource Metric}" />
                                                            <TextBlock Text="max" Style="{StaticResource MetricLabel}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,18,0">
                                                            <TextBlock Text="{Binding Jitter}" Style="{StaticResource Metric}" />
                                                            <TextBlock Text="jitter" Style="{StaticResource MetricLabel}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,18,0">
                                                            <TextBlock Text="{Binding MaxCycleTime}" Style="{StaticResource Metric}" />
                                                            <TextBlock Text="worst cycle" Style="{StaticResource MetricLabel}" />
                                                        </StackPanel>
                                                        <Button Content="Reset" Command="{Binding ResetLatencyCommand}"
                                                                Padding="8,2" VerticalAlignment="Center"
                                                                ToolTip="Clear the min / max / worst-cycle high-water marks." />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Style="{StaticResource Muted}" Text="polls " />
                                                <TextBlock Text="{Binding Polls}" Margin="0,0,14,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text="writes " />
                                                <TextBlock Text="{Binding Writes}" Margin="0,0,14,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text="errors " />
                                                <TextBlock Text="{Binding Errors}" Margin="0,0,14,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text="timeouts " />
                                                <TextBlock Text="{Binding Timeouts}" Margin="0,0,14,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text="points " />
                                                <TextBlock Text="{Binding MappedPointCount}" />
                                            </StackPanel>

                                            <Expander Header="Per-group timing" Foreground="{StaticResource FgMuted}">
                                                <DataGrid ItemsSource="{Binding GroupTimings}" AutoGenerateColumns="False"
                                                          IsReadOnly="True" MaxHeight="160" Margin="0,6,0,0">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Group" Binding="{Binding Name}" Width="*" />
                                                        <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="110" />
                                                        <DataGridTextColumn Header="Addr" Binding="{Binding StartAddress}" Width="60" />
                                                        <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="55" />
                                                        <DataGridTextColumn Header="Set (ms)" Binding="{Binding ConfiguredIntervalMs}" Width="70" />
                                                        <DataGridTextColumn Header="Actual (ms)" Binding="{Binding ActualCycleMs, StringFormat=0.0}" Width="80" />
                                                        <DataGridTextColumn Header="Wire (ms)" Binding="{Binding LastLatencyMs, StringFormat=0.00}" Width="75" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Expander>

                                            <TextBlock Text="{Binding LastError}" Style="{StaticResource Muted}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding TelemetryStatuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="640" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding GameName}" Style="{StaticResource Muted}"
                                                           Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right"
                                                           Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                            </DockPanel>

                                            <Border Background="{StaticResource BgInput}" CornerRadius="3"
                                                    Padding="10,8" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding Rate}" Style="{StaticResource MetricLarge}" />
                                                        <TextBlock Text="frame rate" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding Interval}" Style="{StaticResource MetricLarge}" />
                                                        <TextBlock Text="interval" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding Latency}" Style="{StaticResource Metric}" />
                                                        <TextBlock Text="one-way latency" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding WorstInterval}" Style="{StaticResource Metric}" />
                                                        <TextBlock Text="worst" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding Dropped}" Style="{StaticResource Metric}" />
                                                        <TextBlock Text="dropped" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <Button Content="Reset" Command="{Binding ResetCommand}"
                                                            Padding="8,2" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Muted}" Text="plugin " />
                                                <TextBlock Text="{Binding PluginVersion}" Margin="0,0,14,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text="frames " />
                                                <TextBlock Text="{Binding Frames}" Margin="0,0,14,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text="catalog " />
                                                <TextBlock Text="{Binding CatalogCount}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="vJoy output" Margin="0,14,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Heading}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VJoyStatuses.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding VJoyStatuses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="640">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Capabilities}" Style="{StaticResource Muted}"
                                                           Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right"
                                                           Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                            </DockPanel>

                                            <Border Background="{StaticResource BgInput}" CornerRadius="3"
                                                    Padding="10,8" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding LoopInterval}" Style="{StaticResource MetricLarge}" />
                                                        <TextBlock Text="feed interval" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding WorstLoop}" Style="{StaticResource Metric}" />
                                                        <TextBlock Text="worst" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding ButtonsPressed}" Style="{StaticResource Metric}" />
                                                        <TextBlock Text="pressed now" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding Updates}" Style="{StaticResource Metric}" />
                                                        <TextBlock Text="reports" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,22,0">
                                                        <TextBlock Text="{Binding Failures}" Style="{StaticResource Metric}" />
                                                        <TextBlock Text="failures" Style="{StaticResource MetricLabel}" />
                                                    </StackPanel>
                                                    <Button Content="Reset" Command="{Binding ResetCommand}"
                                                            Padding="8,2" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Muted}" Text="mapped " />
                                                <TextBlock Text="{Binding MappedButtons}" Margin="0,0,4,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text="button(s), " />
                                                <TextBlock Text="{Binding MappedAxes}" Margin="0,0,4,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text="axis/axes" />
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource Warn}" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Servers (HMIs connect here)" Style="{StaticResource Heading}" Margin="0,14,0,6" />

                        <ItemsControl ItemsSource="{Binding ServerStatuses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="640">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="{Binding Endpoint}" Style="{StaticResource Muted}" Margin="10,0,0,0" />
                                                <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right"
                                                           Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                            </DockPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource Muted}" Text="clients " />
                                                <TextBlock Text="{Binding ClientCount}" Margin="0,0,14,0" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Muted}" Text="unit ids " />
                                                <TextBlock Text="{Binding UnitIds}" Margin="0,0,14,0" />
                                                <TextBlock Style="{StaticResource Muted}" Text="points " />
                                                <TextBlock Text="{Binding PointCount}" />
                                            </StackPanel>

                                            <DataGrid ItemsSource="{Binding Clients}" AutoGenerateColumns="False"
                                                      IsReadOnly="True" MaxHeight="160">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Remote" Binding="{Binding RemoteEndPoint}" Width="*" />
                                                    <DataGridTextColumn Header="Since" Binding="{Binding ConnectedAt}" Width="70" />
                                                    <DataGridTextColumn Header="Requests" Binding="{Binding Requests}" Width="75" />
                                                    <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" Width="55" />
                                                    <DataGridTextColumn Header="Unit" Binding="{Binding LastUnitId}" Width="45" />
                                                    <DataGridTextColumn Header="Last FC" Binding="{Binding LastFunction}" Width="60" />
                                                    <DataGridTextColumn Header="Idle" Binding="{Binding IdleMs}" Width="65" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ vJoy ============================ -->
            <TabItem Header="vJoy">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <CheckBox DockPanel.Dock="Top" Content="Enable vJoy output" Margin="0,0,0,8"
                                  IsChecked="{Binding Config.VJoy.Enabled}" />
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Driver" Style="{StaticResource MetricLabel}" />
                                <TextBlock Text="{Binding VJoyDriverStatus}" TextWrapping="Wrap"
                                           Foreground="{Binding VJoyDriverBrush}" />
                            </StackPanel>
                        </Border>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Add" Click="OnAddVJoyDevice" />
                            <Button Content="Delete" Click="OnDeleteVJoyDevice" />
                        </StackPanel>
                        <ListBox x:Name="VJoyDeviceList" ItemsSource="{Binding VJoyDevices}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceId, StringFormat='vJoy device {0}'}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="1" DataContext="{Binding SelectedItem, ElementName=VJoyDeviceList}">
                        <GroupBox DockPanel.Dock="Top" Header="Device">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="vJoy device id" />
                                <TextBox Width="55" Text="{Binding DeviceId}" />
                                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="14,0,0,0" />
                                <Label Content="Update interval (ms)" Margin="18,0,0,0" />
                                <TextBox Width="55" Text="{Binding UpdateIntervalMs}"
                                         ToolTip="Adds to the PLC poll interval to give total contact-to-game latency. A report costs about 4 microseconds, so keep this small." />
                                <CheckBox Content="Always send" IsChecked="{Binding AlwaysSend}" Margin="18,0,0,0"
                                          ToolTip="Send a report every cycle instead of only when something changed." />
                                <CheckBox Content="Release on bad quality" IsChecked="{Binding ReleaseOnBadQuality}"
                                          Margin="18,0,0,0"
                                          ToolTip="Release every control if the driving tags go bad, so a dropped PLC cannot leave a button stuck down." />
                            </StackPanel>
                        </GroupBox>

                        <TabControl BorderThickness="1" BorderBrush="{StaticResource Border}">
                            <TabItem Header="Buttons">
                                <DockPanel Margin="6">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Add" Click="OnAddVJoyButton" />
                                        <Button Content="Delete" Click="OnDeleteVJoyButton" />
                                        <Button Content="Auto-fill..." Click="OnAutoFillVJoyButtons"
                                                ToolTip="Map a numbered run of tags onto a run of buttons in one step." />
                                        <Button Content="Learn..." Click="OnLearnInputs"
                                                Style="{StaticResource PrimaryButton}"
                                                ToolTip="Press a control on the panel; the bridge identifies it, you name it and say what it drives." />
                                    </StackPanel>
                                    <DataGrid x:Name="VJoyButtonGrid" ItemsSource="{Binding Buttons}"
                                              AutoGenerateColumns="False" SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" />
                                            <DataGridTextColumn Header="Button" Binding="{Binding Button}" Width="60" />
                                            <DataGridComboBoxColumn Header="Mode" SelectedItemBinding="{Binding Mode}"
                                                                    ItemsSource="{Binding Source={StaticResource VJoyButtonModeValues}}"
                                                                    Width="110" />
                                            <DataGridTextColumn Header="Pulse ms" Binding="{Binding PulseMs}" Width="70" />
                                            <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold}" Width="70" />
                                            <!-- Invert is the normally-closed toggle at the vJoy end. -->
                                            <DataGridCheckBoxColumn Header="NC" Binding="{Binding Invert}" Width="35" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Axes">
                                <DockPanel Margin="6">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Add" Click="OnAddVJoyAxis" />
                                        <Button Content="Delete" Click="OnDeleteVJoyAxis" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0"
                                                   Text="Swap min and max to reverse an axis. Curve above 1 gives finer control near centre." />
                                    </StackPanel>
                                    <DataGrid x:Name="VJoyAxisGrid" ItemsSource="{Binding Axes}"
                                              AutoGenerateColumns="False" SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" />
                                            <DataGridComboBoxColumn Header="Axis" SelectedItemBinding="{Binding Axis}"
                                                                    ItemsSource="{Binding Source={StaticResource VJoyAxisValues}}"
                                                                    Width="90" />
                                            <DataGridTextColumn Header="In min" Binding="{Binding InputMin}" Width="70" />
                                            <DataGridTextColumn Header="In max" Binding="{Binding InputMax}" Width="70" />
                                            <DataGridTextColumn Header="Deadzone" Binding="{Binding Deadzone}" Width="70" />
                                            <DataGridTextColumn Header="Curve" Binding="{Binding Curve}" Width="60" />
                                            <DataGridTextColumn Header="Deadband" Binding="{Binding Deadband}" Width="70" />
                                            <DataGridCheckBoxColumn Header="Invert" Binding="{Binding Invert}" Width="50" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Hats">
                                <DockPanel Margin="6">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Add" Click="OnAddVJoyPov" />
                                        <Button Content="Delete" Click="OnDeleteVJoyPov" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0"
                                                   Text="Tag value is the hat angle in degrees; a negative value centres the hat." />
                                    </StackPanel>
                                    <DataGrid x:Name="VJoyPovGrid" ItemsSource="{Binding Povs}"
                                              AutoGenerateColumns="False" SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" />
                                            <DataGridTextColumn Header="Hat" Binding="{Binding Pov}" Width="50" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================ SimHub ============================ -->
            <TabItem Header="SimHub">
                <DockPanel Margin="12" DataContext="{Binding Config.Telemetry}">

                    <GroupBox DockPanel.Dock="Top" Header="Telemetry ingest">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox Content="Enable SimHub telemetry" IsChecked="{Binding Enabled}" Width="170" />
                                <Label Content="Listen on" />
                                <TextBox Width="110" Text="{Binding BindAddress}" />
                                <Label Content=":" />
                                <TextBox Width="70" Text="{Binding ListenPort}"
                                         ToolTip="The plugin's settings file must point at this port." />
                                <Label Content="Tag prefix" Margin="16,0,0,0" />
                                <TextBox Width="90" Text="{Binding TagPrefix}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Timeout (ms)" />
                                <TextBox Width="70" Text="{Binding TimeoutMs}"
                                         ToolTip="Telemetry tags go bad if no frame arrives within this long, so an HMI can tell a closed game from a real zero." />
                                <Label Content="Feedback interval (ms)" Margin="16,0,0,0" />
                                <TextBox Width="70" Text="{Binding FeedbackIntervalMs}" />
                                <Label Content="Connected tag" Margin="16,0,0,0" />
                                <TextBox Width="180" Text="{Binding ConnectedTag}" />
                                <Label Content="Game name tag" Margin="16,0,0,0" />
                                <TextBox Width="180" Text="{Binding GameNameTag}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <TabControl BorderThickness="1" BorderBrush="{StaticResource Border}">
                        <TabItem Header="Subscriptions (game to bridge)">
                            <DockPanel Margin="6">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Browse SimHub properties..." Click="OnBrowseSimHubProperties"
                                            Style="{StaticResource PrimaryButton}" />
                                    <Button Content="Add blank" Click="OnAddSubscription" />
                                    <Button Content="Delete" Click="OnDeleteSubscription" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0"
                                               Text="Leave Tag empty to derive it from the property name. Subscribe to one property twice for two units." />
                                </StackPanel>
                                <DataGrid x:Name="SubscriptionGrid" ItemsSource="{Binding Subscriptions}"
                                          AutoGenerateColumns="False" SelectionMode="Extended">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                        <DataGridTextColumn Header="SimHub property" Binding="{Binding Property}" Width="2*" />
                                        <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" />
                                        <DataGridTextColumn Header="Gain" Binding="{Binding Scale.Gain}" Width="80" />
                                        <DataGridTextColumn Header="Offset" Binding="{Binding Scale.Offset}" Width="70" />
                                        <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="70" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="Feedback (bridge to game)">
                            <DockPanel Margin="6">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="Add" Click="OnAddFeedback" />
                                    <Button Content="Delete" Click="OnDeleteFeedback" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="12,0,0,0" TextWrapping="Wrap"
                                               Text="These bridge tags appear inside SimHub as properties (Bridge.&lt;name&gt;) and raise a SimHub event on each rising edge, so a PLC contact can be bound to any SimHub action." />
                                </StackPanel>
                                <DataGrid x:Name="FeedbackGrid" ItemsSource="{Binding Feedback}"
                                          AutoGenerateColumns="False" SelectionMode="Extended">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                        <DataGridTextColumn Header="Bridge tag" Binding="{Binding Tag}" Width="2*" />
                                        <DataGridTextColumn Header="Name in SimHub" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <!-- ============================ Tags ============================ -->
            <TabItem Header="Tags">
                <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Filter" />
                            <TextBox Width="260" Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                            <TextBlock Text="{Binding TagCountText}" Style="{StaticResource Muted}" Margin="12,0" />
                            <Separator Width="1" Margin="6,0" />
                            <Label Content="Value" />
                            <TextBox x:Name="ValueBox" Width="110" />
                            <Button Content="Write" Click="OnWriteTag"
                                    ToolTip="Publish this value to the selected tag once." />
                            <Button Content="Force" Click="OnForceTag"
                                    ToolTip="Pin the tag to this value; sources can no longer change it." />
                            <Button Content="Release" Click="OnUnforceTag"
                                    ToolTip="Release a forced tag and let its source drive it again." />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="TagGrid" ItemsSource="{Binding VisibleTags}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="70" />
                            <DataGridTemplateColumn Header="Quality" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding QualityBrush}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Quality}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="70" />
                            <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="80" />
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="130" />
                            <!-- OneWay: IsForced is read-only, and a check-box column binds two-way by default. -->
                            <DataGridCheckBoxColumn Header="Forced" Binding="{Binding IsForced, Mode=OneWay}" Width="55" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ Devices ============================ -->
            <TabItem Header="Devices (PLCs)">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Add" Click="OnAddClient" />
                            <Button Content="Copy" Click="OnDuplicateClient" />
                            <Button Content="Delete" Click="OnDeleteClient" />
                        </StackPanel>
                        <ListBox x:Name="ClientList" ItemsSource="{Binding Clients}" DisplayMemberPath="Name" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedItem, ElementName=ClientList}">
                        <StackPanel>
                            <GroupBox Header="Connection">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Name" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Text="{Binding Name}" />
                                    <Label Grid.Row="0" Grid.Column="2" Content="Host / IP" Margin="12,0,0,0" />
                                    <TextBox Grid.Row="0" Grid.Column="3" Margin="0,2" Text="{Binding Host}" />
                                    <CheckBox Grid.Row="0" Grid.Column="5" Content="Enabled" Margin="12,0,0,0"
                                              IsChecked="{Binding Enabled}" />

                                    <Label Grid.Row="1" Grid.Column="0" Content="Port" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Port}" />
                                    <Label Grid.Row="1" Grid.Column="2" Content="Unit id" Margin="12,0,0,0" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Margin="0,2" Text="{Binding UnitId}" />
                                    <Label Grid.Row="1" Grid.Column="4" Content="Tag prefix" Margin="12,0,0,0" />
                                    <TextBox Grid.Row="1" Grid.Column="5" Margin="0,2" Text="{Binding TagPrefix}"
                                             ToolTip="Prepended to every tag name in this device, e.g. plc1." />

                                    <Label Grid.Row="2" Grid.Column="0" Content="Connect timeout (ms)" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding ConnectTimeoutMs}" />
                                    <Label Grid.Row="2" Grid.Column="2" Content="Response timeout (ms)" Margin="12,0,0,0" />
                                    <TextBox Grid.Row="2" Grid.Column="3" Margin="0,2" Text="{Binding ResponseTimeoutMs}" />
                                    <Label Grid.Row="2" Grid.Column="4" Content="Inter-request delay (ms)" Margin="12,0,0,0" />
                                    <TextBox Grid.Row="2" Grid.Column="5" Margin="0,2" Text="{Binding InterRequestDelayMs}" />

                                    <Label Grid.Row="3" Grid.Column="0" Content="Reconnect delay (ms)" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding ReconnectDelayMs}" />
                                    <Label Grid.Row="3" Grid.Column="2" Content="Max reconnect (ms)" Margin="12,0,0,0" />
                                    <TextBox Grid.Row="3" Grid.Column="3" Margin="0,2" Text="{Binding MaxReconnectDelayMs}" />
                                    <Label Grid.Row="3" Grid.Column="4" Content="Failures before offline" Margin="12,0,0,0" />
                                    <TextBox Grid.Row="3" Grid.Column="5" Margin="0,2" Text="{Binding FailuresBeforeOffline}" />
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Addressing and byte order">
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Address base" />
                                    <TextBox Width="70" Text="{Binding AddressBase}"
                                             ToolTip="Subtracted from every address here to get the wire address. 0 = wire addresses, 1 = vendor docs numbering from 1." />
                                    <Button Content="Presets..." Click="OnClientAddressPreset" Margin="6,0,0,0" />
                                    <Label Content="Word order" Margin="18,0,0,0" />
                                    <ComboBox Width="110" ItemsSource="{Binding Source={StaticResource WordOrderValues}}"
                                              SelectedItem="{Binding WordOrder}"
                                              ToolTip="Which register holds the high word of a 32/64-bit value. Siemens S7 uses HighFirst." />
                                    <Label Content="Byte order" Margin="18,0,0,0" />
                                    <ComboBox Width="110" ItemsSource="{Binding Source={StaticResource ByteOrderValues}}"
                                              SelectedItem="{Binding ByteOrder}"
                                              ToolTip="Byte order inside each 16-bit register. HighFirst is the Modbus standard." />
                                    <Label Content="Max regs / read" Margin="18,0,0,0" />
                                    <TextBox Width="60" Text="{Binding MaxRegistersPerRead}" />
                                </StackPanel>
                            </GroupBox>

                            <TabControl BorderThickness="1" BorderBrush="{StaticResource Border}" MinHeight="420">
                                <TabItem Header="Read groups (PLC to PC)">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="150" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button Content="Add group" Click="OnAddReadGroup" />
                                            <Button Content="Delete group" Click="OnDeleteReadGroup" />
                                        </StackPanel>

                                        <DataGrid x:Name="ReadGroupGrid" Grid.Row="1" ItemsSource="{Binding ReadGroups}"
                                                  AutoGenerateColumns="False" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                                <DataGridComboBoxColumn Header="Area" SelectedItemBinding="{Binding Area}"
                                                                        ItemsSource="{Binding Source={StaticResource AreaValues}}" Width="130" />
                                                <DataGridTextColumn Header="Start" Binding="{Binding StartAddress}" Width="65" />
                                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60" />
                                                <DataGridTextColumn Header="Poll (ms)" Binding="{Binding PollIntervalMs}" Width="70" />
                                                <DataGridTextColumn Header="Unit id" Binding="{Binding UnitId}" Width="60" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
                                            <TextBlock Text="Points in the selected group" Style="{StaticResource Heading}" Margin="0,0,10,0" />
                                            <Button Content="Add point" Click="OnAddReadPoint" />
                                            <Button Content="Delete point" Click="OnDeleteReadPoint" />
                                            <Button Content="Auto-fill..." Click="OnAutoFillReadPoints"
                                                    ToolTip="Generate a numbered run of points across the group in one step." />
                                        </StackPanel>

                                        <DataGrid x:Name="ReadPointGrid" Grid.Row="3"
                                                  ItemsSource="{Binding SelectedItem.Points, ElementName=ReadGroupGrid}"
                                                  AutoGenerateColumns="False" SelectionMode="Extended">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" />
                                                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="55" />
                                                <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding DataType}"
                                                                        ItemsSource="{Binding Source={StaticResource DataTypeValues}}" Width="90" />
                                                <!-- Bit 0-15 for a Bool packed inside a register; -1 otherwise. -->
                                                <DataGridTextColumn Header="Bit" Binding="{Binding BitIndex}" Width="40" />
                                                <DataGridCheckBoxColumn Header="NC" Binding="{Binding Invert}" Width="35" />
                                                <DataGridTextColumn Header="Gain" Binding="{Binding Scale.Gain}" Width="80" />
                                                <DataGridTextColumn Header="Offset" Binding="{Binding Scale.Offset}" Width="70" />
                                                <DataGridTextColumn Header="Min" Binding="{Binding Scale.Min}" Width="60" />
                                                <DataGridTextColumn Header="Max" Binding="{Binding Scale.Max}" Width="60" />
                                                <DataGridTextColumn Header="Deadband" Binding="{Binding Scale.Deadband}" Width="70" />
                                                <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="60" />
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Write groups (PC to PLC)">
                                    <Grid Margin="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="150" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button Content="Add group" Click="OnAddWriteGroup" />
                                            <Button Content="Delete group" Click="OnDeleteWriteGroup" />
                                            <Button Content="Test outputs..." Click="OnTestOutputs"
                                                    Style="{StaticResource PrimaryButton}"
                                                    ToolTip="Drive each output directly to find out which one is which. Releases everything on close." />
                                        </StackPanel>

                                        <DataGrid x:Name="WriteGroupGrid" Grid.Row="1" ItemsSource="{Binding WriteGroups}"
                                                  AutoGenerateColumns="False" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                                <DataGridComboBoxColumn Header="Area" SelectedItemBinding="{Binding Area}"
                                                                        ItemsSource="{Binding Source={StaticResource AreaValues}}" Width="130" />
                                                <DataGridTextColumn Header="Start" Binding="{Binding StartAddress}" Width="65" />
                                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60" />
                                                <DataGridComboBoxColumn Header="Mode" SelectedItemBinding="{Binding Mode}"
                                                                        ItemsSource="{Binding Source={StaticResource WriteModeValues}}" Width="150" />
                                                <DataGridTextColumn Header="Period (ms)" Binding="{Binding PeriodMs}" Width="80" />
                                                <DataGridCheckBoxColumn Header="Multi" Binding="{Binding UseMultipleWrite}" Width="45" />
                                                <DataGridCheckBoxColumn Header="Whole block" Binding="{Binding AlwaysWriteWholeBlock}" Width="80" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,4">
                                            <TextBlock Text="Points in the selected group" Style="{StaticResource Heading}" Margin="0,0,10,0" />
                                            <Button Content="Add point" Click="OnAddWritePoint" />
                                            <Button Content="Delete point" Click="OnDeleteWritePoint" />
                                        </StackPanel>

                                        <DataGrid x:Name="WritePointGrid" Grid.Row="3"
                                                  ItemsSource="{Binding SelectedItem.Points, ElementName=WriteGroupGrid}"
                                                  AutoGenerateColumns="False" SelectionMode="Extended">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" />
                                                <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="55" />
                                                <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding DataType}"
                                                                        ItemsSource="{Binding Source={StaticResource DataTypeValues}}" Width="90" />
                                                <DataGridTextColumn Header="Bit" Binding="{Binding BitIndex}" Width="40" />
                                                <DataGridCheckBoxColumn Header="Invert" Binding="{Binding Invert}" Width="50" />
                                                <DataGridTextColumn Header="Gain" Binding="{Binding Scale.Gain}" Width="80" />
                                                <DataGridTextColumn Header="Offset" Binding="{Binding Scale.Offset}" Width="70" />
                                                <DataGridTextColumn Header="Min" Binding="{Binding Scale.Min}" Width="60" />
                                                <DataGridTextColumn Header="Max" Binding="{Binding Scale.Max}" Width="60" />
                                                <DataGridTextColumn Header="Deadband" Binding="{Binding Scale.Deadband}" Width="70" />
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Watchdog">
                                    <StackPanel Margin="10" DataContext="{Binding Watchdog}">
                                        <CheckBox Content="Enable the link watchdog" IsChecked="{Binding Enabled}" Margin="0,0,0,10" />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Text="The bridge increments a counter into the PLC on an interval. If the PLC mirrors it back on the read address and that echo stops changing, the link is flagged unhealthy and the health tag goes false." />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Label Content="Write area" />
                                            <ComboBox Width="130" ItemsSource="{Binding Source={StaticResource AreaValues}}"
                                                      SelectedItem="{Binding WriteArea}" />
                                            <Label Content="Write address" Margin="12,0,0,0" />
                                            <TextBox Width="80" Text="{Binding WriteAddress}" />
                                            <Label Content="Interval (ms)" Margin="12,0,0,0" />
                                            <TextBox Width="80" Text="{Binding IntervalMs}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Label Content="Read area" />
                                            <ComboBox Width="130" ItemsSource="{Binding Source={StaticResource AreaValues}}"
                                                      SelectedItem="{Binding ReadArea}" />
                                            <Label Content="Read address" Margin="12,0,0,0" />
                                            <TextBox Width="80" Text="{Binding ReadAddress}"
                                                     ToolTip="-1 sends a heartbeat without expecting an echo back." />
                                            <Label Content="Timeout (ms)" Margin="12,0,0,0" />
                                            <TextBox Width="80" Text="{Binding TimeoutMs}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Label Content="Health tag" />
                                            <TextBox Width="240" Text="{Binding HealthTag}" />
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================ Servers ============================ -->
            <TabItem Header="Servers (HMIs)">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Add" Click="OnAddServer" />
                            <Button Content="Delete" Click="OnDeleteServer" />
                        </StackPanel>
                        <ListBox x:Name="ServerList" ItemsSource="{Binding Servers}" DisplayMemberPath="Name" />
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedItem, ElementName=ServerList}">
                        <StackPanel>
                            <GroupBox Header="Listener">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Label Content="Name" />
                                        <TextBox Width="160" Text="{Binding Name}" />
                                        <Label Content="Bind address" Margin="12,0,0,0" />
                                        <TextBox Width="130" Text="{Binding BindAddress}"
                                                 ToolTip="0.0.0.0 listens on every interface; enter a specific NIC address to restrict it." />
                                        <Label Content="Port" Margin="12,0,0,0" />
                                        <TextBox Width="70" Text="{Binding Port}" />
                                        <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="16,0,0,0" />
                                        <CheckBox Content="Read-only" IsChecked="{Binding ReadOnly}" Margin="12,0,0,0"
                                                  ToolTip="Reject every write function code, whatever the per-point access says." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Label Content="Max clients" />
                                        <TextBox Width="60" Text="{Binding MaxClients}" />
                                        <Label Content="Idle timeout (s)" Margin="12,0,0,0" />
                                        <TextBox Width="60" Text="{Binding IdleTimeoutSec}" />
                                        <CheckBox Content="TCP_NODELAY" IsChecked="{Binding NoDelay}" Margin="12,0,0,0"
                                                  ToolTip="Off adds ~40 ms to small responses. Leave on." />
                                        <Label Content="Address base" Margin="12,0,0,0" />
                                        <TextBox Width="60" Text="{Binding AddressBase}" />
                                        <Label Content="Word order" Margin="12,0,0,0" />
                                        <ComboBox Width="100" ItemsSource="{Binding Source={StaticResource WordOrderValues}}"
                                                  SelectedItem="{Binding WordOrder}" />
                                        <Label Content="Byte order" Margin="12,0,0,0" />
                                        <ComboBox Width="100" ItemsSource="{Binding Source={StaticResource ByteOrderValues}}"
                                                  SelectedItem="{Binding ByteOrder}" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Maps (one per unit id)">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="110" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="Add map" Click="OnAddMap" />
                                        <Button Content="Delete map" Click="OnDeleteMap" />
                                    </StackPanel>
                                    <DataGrid x:Name="MapGrid" Grid.Row="1" ItemsSource="{Binding Maps}"
                                              AutoGenerateColumns="False" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Unit id" Binding="{Binding UnitId}" Width="65" />
                                            <DataGridCheckBoxColumn Header="Any unit id" Binding="{Binding AcceptAnyUnitId}" Width="80" />
                                            <DataGridTextColumn Header="Tag prefix" Binding="{Binding TagPrefix}" Width="140" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Blocks in the selected map">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="130" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="Add block" Click="OnAddBlock" />
                                        <Button Content="Delete block" Click="OnDeleteBlock" />
                                    </StackPanel>
                                    <DataGrid x:Name="BlockGrid" Grid.Row="1"
                                              ItemsSource="{Binding SelectedItem.Blocks, ElementName=MapGrid}"
                                              AutoGenerateColumns="False" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridComboBoxColumn Header="Area" SelectedItemBinding="{Binding Area}"
                                                                    ItemsSource="{Binding Source={StaticResource AreaValues}}" Width="130" />
                                            <DataGridTextColumn Header="Start" Binding="{Binding StartAddress}" Width="65" />
                                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="55" />
                                            <DataGridComboBoxColumn Header="When stale" SelectedItemBinding="{Binding StaleBehavior}"
                                                                    ItemsSource="{Binding Source={StaticResource StaleValues}}" Width="140" />
                                            <DataGridTextColumn Header="Stale after (ms)" Binding="{Binding StaleTimeoutMs}" Width="100" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Points in the selected block">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="260" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="Add point" Click="OnAddServerPoint" />
                                        <Button Content="Delete point" Click="OnDeleteServerPoint" />
                                        <Button Content="Auto-fill..." Click="OnAutoFillServerPoints" />
                                    </StackPanel>
                                    <DataGrid x:Name="ServerPointGrid" Grid.Row="1"
                                              ItemsSource="{Binding SelectedItem.Points, ElementName=BlockGrid}"
                                              AutoGenerateColumns="False" SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="35" />
                                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" />
                                            <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="55" />
                                            <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding DataType}"
                                                                    ItemsSource="{Binding Source={StaticResource DataTypeValues}}" Width="90" />
                                            <DataGridTextColumn Header="Bit" Binding="{Binding BitIndex}" Width="40" />
                                            <DataGridComboBoxColumn Header="Access" SelectedItemBinding="{Binding Access}"
                                                                    ItemsSource="{Binding Source={StaticResource AccessValues}}" Width="95" />
                                            <DataGridCheckBoxColumn Header="Invert" Binding="{Binding Invert}" Width="50" />
                                            <DataGridTextColumn Header="Gain" Binding="{Binding Scale.Gain}" Width="70" />
                                            <DataGridTextColumn Header="Offset" Binding="{Binding Scale.Offset}" Width="65" />
                                            <DataGridTextColumn Header="Failsafe" Binding="{Binding FailsafeValue}" Width="65" />
                                            <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="60" />
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================ Simulation ============================ -->
            <TabItem Header="Simulation">
                <StackPanel Margin="16" DataContext="{Binding Config.Simulation}">
                    <TextBlock Text="Bench testing without hardware" Style="{StaticResource Heading}" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="820"
                               HorizontalAlignment="Left"
                               Text="The virtual PLC is a real Modbus TCP slave with animated inputs - point a device entry at its address and the whole read path works with no hardware. The waveform generator drives telemetry tags so HMI screens and register maps can be proven before SimHub is connected. A real source always takes precedence over a simulated one." />

                    <CheckBox Content="Enable simulation" IsChecked="{Binding Enabled}" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="Virtual PLC" IsChecked="{Binding VirtualPlcEnabled}" Width="150" />
                        <Label Content="Bind" />
                        <TextBox Width="130" Text="{Binding VirtualPlcBindAddress}" />
                        <Label Content="Port" Margin="12,0,0,0" />
                        <TextBox Width="80" Text="{Binding VirtualPlcPort}" />
                    </StackPanel>

                    <CheckBox Content="Generate telemetry waveforms" IsChecked="{Binding GenerateTelemetry}" Margin="0,0,0,10" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Add tag" Click="OnAddSimTag" />
                        <Button Content="Delete tag" Click="OnDeleteSimTag" />
                    </StackPanel>

                    <DataGrid x:Name="SimTagGrid" ItemsSource="{Binding Tags}" AutoGenerateColumns="False"
                              Height="320" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" />
                            <!-- sine, triangle, sawtooth, ramp, square, random or constant -->
                            <DataGridTextColumn Header="Waveform" Binding="{Binding Waveform}" Width="120" />
                            <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="80" />
                            <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="80" />
                            <DataGridTextColumn Header="Period (s)" Binding="{Binding PeriodSec}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </TabItem>

            <!-- ============================ Log ============================ -->
            <TabItem Header="Log">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="Show" />
                        <ComboBox Width="110" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogFilter}" />
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" Margin="10,0,0,0" />
                        <CheckBox x:Name="AutoScroll" Content="Follow" IsChecked="True" Margin="10,0,0,0" />
                    </StackPanel>

                    <DataGrid x:Name="LogGrid" ItemsSource="{Binding LogRows}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas" />
                                        <Setter Property="Foreground" Value="{StaticResource FgMuted}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Brush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="160" />
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
