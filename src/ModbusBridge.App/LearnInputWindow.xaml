<Window x:Class="ModbusBridge.App.LearnInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Learn inputs" Height="560" Width="720"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                       Text="Press a control on the panel. The bridge shows which tag moved, you give it a name and say what it should drive. No addresses involved." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <!-- Analog inputs move constantly, so they would win every race against a button
                     press. Off by default; turn it on to learn a pedal or a pot. -->
                <CheckBox x:Name="IncludeAnalogBox" Content="Include analog inputs" Click="OnRearm" />
                <Label Content="movement over" Margin="12,0,0,0" />
                <TextBox x:Name="AnalogThresholdBox" Width="70" Text="500"
                         ToolTip="How far an analog input must move, in raw counts, before it counts as the one you meant." />
                <Label Content="counts" />
            </StackPanel>
        </StackPanel>

        <!-- What was just detected -->
        <Border Grid.Row="1" Background="{StaticResource BgInput}" CornerRadius="3" Padding="12">
            <StackPanel>
                <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold"
                           Text="Waiting for input..." />
                <TextBlock x:Name="DetailText" Style="{StaticResource Muted}" FontFamily="Consolas"
                           TextWrapping="Wrap" Margin="0,4,0,0" Text="" />
            </StackPanel>
        </Border>

        <!-- Assignment -->
        <Grid Grid.Row="2" Margin="0,12,0,0" x:Name="AssignPanel" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Name" />
            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,3">
                <TextBlock x:Name="PrefixText" VerticalAlignment="Center" Style="{StaticResource Muted}"
                           FontFamily="Consolas" Margin="0,0,2,0" />
                <TextBox x:Name="NameBox" />
            </DockPanel>

            <Label Grid.Row="1" Grid.Column="0" Content="Drives" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                <ComboBox x:Name="TargetCombo" Width="150" SelectionChanged="OnTargetChanged" />

                <!-- Button options -->
                <StackPanel x:Name="ButtonOptions" Orientation="Horizontal" Margin="12,0,0,0">
                    <Label Content="Button" />
                    <TextBox x:Name="ButtonBox" Width="55" />
                    <Label Content="Mode" Margin="10,0,0,0" />
                    <ComboBox x:Name="ButtonModeCombo" Width="110" />
                </StackPanel>

                <!-- Hat options -->
                <StackPanel x:Name="HatOptions" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
                    <Label Content="Hat" />
                    <TextBox x:Name="PovBox" Width="40" Text="1" />
                    <Label Content="Direction" Margin="10,0,0,0" />
                    <ComboBox x:Name="HatDirectionCombo" Width="90" />
                    <Label Content="Kind" Margin="10,0,0,0" />
                    <ComboBox x:Name="HatKindCombo" Width="100" />
                </StackPanel>

                <!-- Axis options -->
                <StackPanel x:Name="AxisOptions" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
                    <Label Content="Axis" />
                    <ComboBox x:Name="AxisCombo" Width="90" />
                    <Label Content="Min" Margin="10,0,0,0" />
                    <TextBox x:Name="AxisMinBox" Width="70" Text="0" />
                    <Label Content="Max" Margin="6,0,0,0" />
                    <TextBox x:Name="AxisMaxBox" Width="70" Text="27648" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Row="1" Grid.Column="2" Content="Assign" Click="OnAssign"
                    Style="{StaticResource PrimaryButton}" Margin="10,3,0,3" MinWidth="90" />

            <Label Grid.Row="2" Grid.Column="0" Content="Description" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3" x:Name="DescriptionBox" />
        </Grid>

        <!-- What has been assigned so far -->
        <DataGrid Grid.Row="3" x:Name="AssignedGrid" Margin="0,12,0,0" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="2*" />
                <DataGridTextColumn Header="Was" Binding="{Binding OldTag}" Width="1.4*" />
                <DataGridTextColumn Header="Drives" Binding="{Binding Target}" Width="1.4*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource Muted}"
                       Margin="0,0,14,0" />
            <Button Content="Skip / re-arm" Click="OnRearm" />
            <Button Content="Done" Click="OnDone" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
