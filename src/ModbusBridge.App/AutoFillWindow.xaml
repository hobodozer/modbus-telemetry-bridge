<Window x:Class="ModbusBridge.App.AutoFillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto-fill points" SizeToContent="Height" Width="520"
        Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Generates a numbered run of points. Use {n} in the tag name for the index - it is replaced with the counter, zero-padded to the width you choose." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="Tag pattern" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3" x:Name="PatternBox" Text="di.btn{n}" />

            <Label Grid.Row="1" Grid.Column="0" Content="Count" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" x:Name="CountBox" Text="16" />

            <Label Grid.Row="2" Grid.Column="0" Content="First index" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" x:Name="FirstIndexBox" Text="1" />

            <Label Grid.Row="3" Grid.Column="0" Content="Index digits" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" x:Name="DigitsBox" Text="2" />

            <Label Grid.Row="4" Grid.Column="0" Content="First offset" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" x:Name="FirstOffsetBox" Text="0" />

            <Label Grid.Row="5" Grid.Column="0" Content="Data type" />
            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,3" x:Name="TypeCombo" />

            <Label Grid.Row="6" Grid.Column="0" Content="Access" />
            <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,3" x:Name="AccessCombo" />

            <Label Grid.Row="7" Grid.Column="0" Content="Description" />
            <TextBox Grid.Row="7" Grid.Column="1" Margin="0,3" x:Name="DescriptionBox" Text="Button {n}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="PackBitsBox" Content="Pack Bools as bits inside registers"
                      ToolTip="16 booleans per register instead of one point per register. Only applies to register areas." />
            <CheckBox x:Name="InvertBox" Content="Normally closed (invert)" Margin="16,0,0,0" />
        </StackPanel>

        <GroupBox Header="Scaling applied to every generated point" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Label Content="Gain" />
                <TextBox Width="90" x:Name="GainBox" Text="1" />
                <Label Content="Offset" Margin="10,0,0,0" />
                <TextBox Width="80" x:Name="OffsetBox" Text="0" />
                <Label Content="Deadband" Margin="10,0,0,0" />
                <TextBox Width="80" x:Name="DeadbandBox" Text="0" />
            </StackPanel>
        </GroupBox>

        <Border Background="{StaticResource BgInput}" CornerRadius="3" Padding="8" Margin="0,12,0,0">
            <TextBlock x:Name="PreviewText" Style="{StaticResource Muted}" TextWrapping="Wrap"
                       FontFamily="Consolas" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Preview" Click="OnPreview" />
            <Button Content="Cancel" Click="OnCancel" />
            <Button Content="Generate" Click="OnGenerate" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
